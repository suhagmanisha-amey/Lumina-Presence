# Copy to .env and fill in. Never commit .env.

# --- Required: caption writing + trend research ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: real Instagram publishing ---
# Leave these unset and the agent stays in draft-only mode (dry-run publisher).
# See README "Turning on real publishing" for how to obtain them.
IG_USER_ID=
IG_ACCESS_TOKEN=

# Instagram's Graph API cannot accept a file upload — it fetches your media
# from a public HTTPS URL. Point this at a folder you serve publicly whose
# contents mirror assets/library/ (S3 bucket, CDN, GitHub Pages, etc.).
# Example: https://cdn.thelumina.in/ig
MEDIA_BASE_URL=
